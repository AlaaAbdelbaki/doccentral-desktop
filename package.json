{
  "name": "doccentral-desktop",
  "productName": "DocCentral",
  "version": "0.1.0",
  "description": "DocCentral desktop — dental clinic management (Electron, offline-first SQLite, Supabase sync)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.jsx --bundle --outfile=dist/bundle.js --jsx=automatic --loader:.sql=text",
    "start": "npm run build && electron .",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:unit": "node --test tests/unit/*.test.js tests/unit/*.test.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win",
    "postinstall": "install-electron",
    "icons": "electron scripts/render-icon.js build/icon.svg build/icon.png 1024 && electron scripts/render-icon.js build/icon-alt-d.svg build/icon-alt-d.png 1024"
  },
  "dependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.0",
    "@supabase/supabase-js": "^2.119.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "author": "DocCentral",
  "build": {
    "appId": "com.doccentral.desktop",
    "productName": "DocCentral",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "db.js",
      "preload.js",
      "package.json",
      "src/index.html",
      "src/*.css",
      "dist/bundle.js",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocCentral",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "${productName}-Setup-${version}.${ext}"
  }
}
